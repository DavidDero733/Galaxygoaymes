rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPost(data) {
      return data.keys().hasAll(['userId', 'authorName', 'content', 'type', 'visibility', 'createdAt']) &&
             data.keys().size() == 6 &&
             data.userId is string && data.userId == request.auth.uid &&
             data.authorName is string && data.authorName.size() > 0 && data.authorName.size() <= 100 &&
             data.content is string && data.content.size() > 0 && data.content.size() <= 1000 &&
             data.type in ['comment', 'request'] &&
             data.visibility == 'public' &&
             data.createdAt == request.time;
    }

    match /posts/{postId} {
      allow get: if isValidId(postId) && resource.data.visibility == 'public';
      
      allow list: if resource.data.visibility == 'public';

      allow create: if isSignedIn() && isValidId(postId) && isValidPost(incoming());
      
      allow delete: if isSignedIn() && isValidId(postId) && existing().userId == request.auth.uid;
      
      allow update: if isSignedIn() && isValidId(postId) && isValidPost(incoming()) && (
        (incoming().diff(existing()).affectedKeys().hasOnly(['content', 'createdAt'])) &&
        existing().userId == request.auth.uid
      );
    }
  }
}
